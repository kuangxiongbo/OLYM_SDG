# SDG Web界面环境变量配置
# ================================
# 生产环境 PostgreSQL 数据库配置

# Flask 基础配置
# ----------------
FLASK_ENV=production
FLASK_DEBUG=False
# 生产环境请使用强随机密钥（可通过 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=your_secret_key_here_change_in_production

# 数据库配置（生产环境 PostgreSQL）
# ------------------
# 远程 PostgreSQL 数据库连接
# 格式：postgresql+psycopg2://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+psycopg2://SDC:nScWntDCaEajtJmD@192.168.210.90:5433/SDC

# 文件上传配置
# ----------------
MAX_CONTENT_LENGTH=52428800
UPLOAD_FOLDER=uploads
RESULTS_FOLDER=results

# 日志配置
# ----------
LOG_LEVEL=INFO
LOG_FILE=app.log

# 会话配置
# ----------
SESSION_TIMEOUT=3600
MAX_SESSIONS=100

# 生成任务默认参数
# ----------
MAX_SAMPLES=10000
MIN_SAMPLES=10
DEFAULT_SAMPLES=100
